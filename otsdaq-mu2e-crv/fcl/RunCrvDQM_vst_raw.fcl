# File-based dry run of the TDAQ CrvDQM module on VST-stream raw .art.
# Decode with CrvDigisFromArtdaqFragmentsFEBII, then CrvDQM.
# Does not talk to hardware, otsdaq VisualSupervisor, or HistoSender.
#
# Drive with tdaq_run_crv_dqm.sh (TDAQ Spack env + local Offline/otsdaq install).
# Do not run this with muse `mu2e`.

#include "Offline/fcl/standardServices.fcl"

process_name : CrvDQM

services : {
  @table::Services.Core
  @table::Services.Reco
  TFileService : {
    fileName : "crvDQM.root"
  }
}

source : {
  module_type : RootInput
  fileNames   : @nil
  maxEvents   : -1
}

physics : {
  producers : {
    crvdigi : {
      module_type    : CrvDigisFromArtdaqFragmentsFEBII
      diagLevel      : 0
      produceNZS     : false
      useROC4asROC2  : true
    }
  }
  analyzers : {
    crvdqm : {
      module_type      : CrvDQM
      crvDigiTag       : "crvdigi"
      crvStatusTag     : "crvdigi"
      diagLevel        : 1
      sendHists        : false
      enableHttpServer : false
      dummyHist        : false
      cfFraction       : 0.20
      dtBinSize        : 0.5
      dtRange          : 50.0
      minAmplitude     : 10
      saveCanvasesToPdf: false
      showSameFpgaTimingInCanvas: false

      # Histogram segmentation AND online publishing. This is the file-mode
      # dry run, so unlike the live RunCrvDQM.fcl it sets persist/persistLive
      # TRUE -- writing the copies to the output file is the only way to
      # inspect them offline -- and uses a short span so a few thousand events
      # are enough to see the ring rotate. `publish`/`group` are unchanged from
      # the live config: they decide what HistoSender ships and under which
      # folder, so the module holds no list of its own.
      # See CrvDQM_segmentation_examples.fcl and Offline/DQMHelpers/README.md.
      segmentation : {
        rules : [
          # Shipped under their own names, so the GUI keeps subscribing to the
          # names it already knows -- including the rolling copy, via liveName.
          { match    : "h1_channels"
            modes    : [ "job", "window" ]
            window   : { span : 2000  unit : "ewt"  subdivisions : 10
                         keep : 3  persist : true   persistLive : true }
            liveName : "h1_channelsLastEwt"
            publish  : true
          },

          { match : "h2_channels"    modes : [ "job" ]  publish : true },
          { match : "h1_digisPerEvt" modes : [ "job" ]  publish : true },
          { match : "h1_peakAdc"     modes : [ "job" ]  publish : true },
          { match : "h1_tdc"         modes : [ "job" ]  publish : true },

          # Collected under one label, as the timing summary always has been.
          { match : "dtVsFeb"  modes : [ "job" ]  publish : true  group : "timing_feb" },

          { match    : "dtOutOfRangePerFeb"
            modes    : [ "job", "window" ]
            window   : { span : 2000  unit : "ewt"  subdivisions : 10
                         keep : 3  persist : true   persistLive : true }
            liveName : "dtOutOfRangePerFebLastEwt"
            publish  : true
            group    : "timing_feb"
          },

          # Thousands of these: one group, and never a window rule.
          { match : "timing_fpga/*"  modes : [ "job" ]  publish : true  group : "timing_fpga" }

          # Anything not named above is booked job-only and not shipped. That
          # is deliberate: crvDigiRates* and crvDigisPerChannel are large and
          # are not on the display, so publishing them would cost bandwidth
          # for nothing. Add `publish : true` here to change that -- no rebuild.
        ]
      }

      # Per-link status plots (CRVStatusDQM, under status/), shipped together
      # as crv/status. The per-link histograms are h1_*_link<N>, the summaries
      # h2_*; the helper's other status histograms are not shipped.
      statusSegmentation : {
        rules : [
          { match : "h1_*"  modes : [ "job" ]  publish : true  group : "status" },
          { match : "h2_*"  modes : [ "job" ]  publish : true  group : "status" }
        ]
      }
    }
  }
  t1 : [ crvdigi ]
  a1 : [ crvdqm ]
  trigger_paths : [ t1 ]
  end_paths     : [ a1 ]
}

services.TimeTracker.printSummary: true
services.scheduler.wantSummary: true
services.message.destinations.log.outputStatistics : false
services.GeometryService.inputFile: "Offline/Mu2eG4/geom/geom_common_extracted.txt"

# Same VST 124155 conditions as unpack_data_vst.fcl (no CRV IOV in the DB).
services.ProditionsService.crvStatus.useDb : true
services.ProditionsService.crvCalib.useDb  : true
services.DbService.purpose : Sim_best
services.DbService.version : v1_5
services.DbService.textFile : [
  "Offline/CRVConditions/data/status_extracted_20260630.txt",
  "Offline/CRVConditions/data/calib_extracted_20260630.txt",
  "Offline/TrackerConditions/data/TrkPanelMap.txt"
]
services.DbService.verbose : 0
services.ProditionsService.trackerPanelMap.useDb : true
