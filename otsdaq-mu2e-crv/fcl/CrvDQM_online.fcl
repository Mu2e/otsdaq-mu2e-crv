# Online CrvDQM configuration using the upstream CRVDQM prolog from Offline.
#
# The CrvDQM module itself lives in otsdaq-mu2e-dqm; this file only provides
# the aliases the OTS configuration database references. Binning is fixed in
# Offline/CRVDQM; the `digi` and `status` tables choose which copies of each
# histogram exist and which HistoSender ships (Offline/CRVDQM/fcl/prolog.fcl).
#
# Include it before any non-prolog content, then use the module table and set
# the site-specific parameters (tags, HistoSender address/port, HTTP server):
#
#   #include "CrvDQM_online.fcl"
#   ...
#   crvdqm : {
#     @table::crvDqmOnline
#     crvDigiTag   : "<CRV unpacker label>"
#     crvStatusTag : "<CRV unpacker label>"
#     address      : "<HistoSender host>"
#     port         : <HistoSender port>
#   }

#include "Offline/CRVDQM/fcl/prolog.fcl"

BEGIN_PROLOG

# Whole client tables (each carries a `hists` block), as CrvDQM's `digi` and
# `status` parameters expect. The OTS config database references these names.
crvDqmOnlineDigi   : @local::CRVDQM.DigiOnline
crvDqmOnlineStatus : @local::CRVDQM.StatusLinksOnline

crvDqmOnline : {
  module_type : CrvDQM
  digi        : @local::crvDqmOnlineDigi
  status      : @local::crvDqmOnlineStatus
}

END_PROLOG
