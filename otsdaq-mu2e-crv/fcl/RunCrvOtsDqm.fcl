#include "mu2e-trig-config/core/trigProducers.fcl"
#include "Offline/fcl/standardProducers.fcl"
#include "Offline/fcl/standardServices.fcl"
#include "Offline/CRVResponse/fcl/prolog.fcl"

process_name : CrvOtsDqm

services :{
  @table::Services.Core
  @table::Services.Reco
  TFileService : {
    fileName : "crvOtsDqm.root"
  }
}

source : {
  module_type : RootInput
  fileNames   : @nil
  maxEvents   : -1
}

physics : {
  producers :
  {
    crvdigi :
    {
      module_type   : CrvDigisFromArtdaqFragmentsFEBII
      diagLevel     : 0
      useSubsystem0 : false
      produceNZS : false
      # useOnlineChannel: true

    }
  }
  analyzers : {
    crvdqm : {
      module_type           : CrvOtsDQM
      diagLevel             : 3
      sendHists             : false
    }
    CrvDQMcollector: @local::CrvDQMcollector
  }

  t1 : [ crvdigi ] 
  a1 : [ crvdqm ]

  trigger_paths  : [t1]
  end_paths      : [a1]

}

outputs:{}

services.TimeTracker.printSummary: true
services.scheduler.wantSummary: true
services.message.destinations.log.outputStatistics : true
services.GeometryService.inputFile: "Offline/Mu2eG4/geom/geom_common_extracted.txt"